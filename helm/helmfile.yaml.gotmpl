helmDefaults:
  timeout: 1200

{{/* ===== Load values file ===== */}}
{{- $ValuesFilePath := env "HELMFILE_VALUES" | default (printf "%s/values.yaml" (env "PWD")) }}
{{- $deployValues   := readFile $ValuesFilePath | fromYaml }}

{{/* ===== Per-component value slices ===== */}}
{{- $generalValues          := index $deployValues "general"          | default dict }}
{{- $resourcesValues        := index $deployValues "resources"        | default dict }}
{{- $idpValues              := index $deployValues "idp"              | default dict }}
{{- $apiSrvValues           := index $deployValues "apiSrv"           | default dict }}
{{- $dockerRegistryValues   := index $deployValues "dockerRegistry"   | default dict }}
{{- $edgeValues             := index $deployValues "edge"             | default dict }}
{{- $gitValues              := index $deployValues "git"              | default dict }}
{{- $searchValues           := index $deployValues "search"           | default dict }}
{{- $billingValues          := index $deployValues "billing"          | default dict }}
{{- $notifierValues         := index $deployValues "notifier"         | default dict }}
{{- $monitoringValues       := index $deployValues "monitoring"       | default dict }}
{{- $storageLifecycleValues := index $deployValues "storageLifecycle" | default dict }}
{{- $davValues              := index $deployValues "dav"              | default dict }}
{{- $postDeployValues       := index $deployValues "postDeploy"       | default dict }}
{{- $shareSrvValues         := index $deployValues "shareSrv"         | default dict }}
{{- $runPolicyManagerValues := index $deployValues "runPolicyManager" | default dict }}

{{/* Inject build version from CP_BUILD_VERSION.txt when not already set in values */}}
{{- $fileVersion := exec "sh" (list "-c" (printf "cat '%s/CP_BUILD_VERSION.txt' 2>/dev/null | tr -d '[:space:]'" (env "PWD"))) }}
{{- if and $fileVersion (not (index $generalValues "buildVersion")) }}
  {{- $_ := set $generalValues "buildVersion" $fileVersion }}
{{- end }}

{{/* ===== release.installed conditions ===== */}}
{{- $idpInstalled              := $idpValues.enabled | default false }}
{{- $apiDbInstalled            := eq (index ($apiSrvValues.db | default dict) "type" | default "external") "internal" }}
{{- $monitoringInstalled       := index $monitoringValues "enabled" | default true }}
{{- $dockerRegistryInstalled   := index $dockerRegistryValues "enabled" | default true }}
{{- $searchInstalled           := index $searchValues "enabled" | default false }}
{{- $billingInstalled          := index $billingValues "enabled" | default true }}
{{- $gitInstalled              := $gitValues.enabled | default false }}
{{- $notifierInstalled         := index $notifierValues "enabled" | default false }}
{{- $storageLifecycleInstalled := index $storageLifecycleValues "enabled" | default true }}
{{- $davInstalled              := index $davValues "enabled" | default true }}
{{- $shareSrvInstalled         := $shareSrvValues.enabled | default false }}
{{- $runPolicyManagerInstalled := index $runPolicyManagerValues "enabled" | default false }}

releases:

  # ── cp-resources ─────────────────────────────────────────────────────────────
  - name: cp-resources
    chart: ./cloud-pipeline/cp-resources
    values:
      - cloud-pipeline/cp-resources/values.yaml
      -
{{- $generalValues | toYaml | nindent 8 }}
      -
{{- $resourcesValues | toYaml | nindent 8 }}
      -
{{- dict "idp" (dict "enabled" $idpInstalled) | toYaml | nindent 8 }}
    wait: true

  # ── cp-idp ───────────────────────────────────────────────────────────────────
  - name: cp-idp
    installed: {{ $idpInstalled }}
    chart: ./cloud-pipeline/cp-idp
    values:
      - cloud-pipeline/cp-idp/values.yaml
      -
{{- toYaml $generalValues | nindent 8 }}
      -
{{- toYaml $idpValues | nindent 8 }}
      -
{{- dict "apiSrv" (dict "service" (index $apiSrvValues "service" | default dict)) | toYaml | nindent 8 }}
      -
{{- dict "git" (dict "enabled" $gitInstalled "service" (index $gitValues "service" | default dict) "ssoEndpointId" (index (index $gitValues "config" | default dict) "CP_GITLAB_SSO_ENDPOINT_ID" | default "")) | toYaml | nindent 8 }}
      -
{{- dict "shareSrv" (dict "enabled" $shareSrvInstalled "service" (index $shareSrvValues "service" | default dict)) | toYaml | nindent 8 }}
    needs:
      - cp-resources
    wait: true

  # ── cp-api-db ─────────────────────────────────────────────────────────────────
  - name: cp-api-db
    installed: {{ $apiDbInstalled }}
    chart: ./cloud-pipeline/cp-api-db
    values:
      - cloud-pipeline/cp-api-db/values.yaml
      -
{{- toYaml $generalValues | nindent 8 }}
      -
{{- dict "db" (index $apiSrvValues "db" | default dict) | toYaml | nindent 8 }}
    needs:
      - cp-resources
    wait: true

  # ── cp-api-srv ────────────────────────────────────────────────────────────────
  - name: cp-api-srv
    chart: ./cloud-pipeline/cp-api-srv
    values:
      - cloud-pipeline/cp-api-srv/values.yaml
      -
{{- toYaml $generalValues | nindent 8 }}
      -
{{- toYaml $apiSrvValues | nindent 8 }}
    needs:
      - cp-resources
      - cp-idp
      - cp-api-db
    wait: true

  # ── cp-monitoring ─────────────────────────────────────────────────────────────
  - name: cp-monitoring
    installed: {{ $monitoringInstalled }}
    chart: ./cloud-pipeline/cp-monitoring
    values:
      - cloud-pipeline/cp-monitoring/values.yaml
      -
{{- toYaml $generalValues | nindent 8 }}
      -
{{- toYaml $monitoringValues | nindent 8 }}
    needs:
      - cp-resources
      - cp-api-srv
    wait: true

  # ── cp-docker-registry ────────────────────────────────────────────────────────
  - name: cp-docker-registry
    installed: {{ $dockerRegistryInstalled }}
    chart: ./cloud-pipeline/cp-docker-registry
    values:
      - cloud-pipeline/cp-docker-registry/values.yaml
      -
{{- toYaml $generalValues | nindent 8 }}
      -
{{- toYaml $dockerRegistryValues | nindent 8 }}
    needs:
      - cp-api-srv
    wait: true

  # ── cp-search ─────────────────────────────────────────────────────────────────
  - name: cp-search
    installed: {{ $searchInstalled }}
    chart: ./cloud-pipeline/cp-search
    values:
      - cloud-pipeline/cp-search/values.yaml
      -
{{- toYaml $generalValues | nindent 8 }}
      -
{{- toYaml $searchValues | nindent 8 }}
    needs:
      - cp-resources
      - cp-api-srv
    wait: true

  # ── cp-billing-srv ────────────────────────────────────────────────────────────
  - name: cp-billing-srv
    installed: {{ $billingInstalled }}
    chart: ./cloud-pipeline/cp-billing-srv
    values:
      - cloud-pipeline/cp-billing-srv/values.yaml
      -
{{- toYaml $generalValues | nindent 8 }}
      -
{{- toYaml $billingValues | nindent 8 }}
    needs:
      - cp-resources
      - cp-api-srv
      - cp-search
    wait: true

  # ── cp-git ────────────────────────────────────────────────────────────────────
  - name: cp-git
    installed: {{ $gitInstalled }}
    chart: ./cloud-pipeline/cp-git
    values:
      - cloud-pipeline/cp-git/values.yaml
      -
{{- toYaml $generalValues | nindent 8 }}
      -
{{- toYaml $gitValues | nindent 8 }}
    needs:
      - cp-resources
      - cp-idp
      - cp-api-srv
    wait: true

  # ── cp-notifier ───────────────────────────────────────────────────────────────
  - name: cp-notifier
    installed: {{ $notifierInstalled }}
    chart: ./cloud-pipeline/cp-notifier
    values:
      -
{{- toYaml $generalValues | nindent 8 }}
      -
{{- toYaml $notifierValues | nindent 8 }}
    needs:
      - cp-resources
      - cp-api-srv
    wait: true

  # ── cp-storage-lifecycle-service ──────────────────────────────────────────────
  - name: cp-storage-lifecycle-service
    installed: {{ $storageLifecycleInstalled }}
    chart: ./cloud-pipeline/cp-storage-lifecycle-service
    values:
      - cloud-pipeline/cp-storage-lifecycle-service/values.yaml
      -
{{- toYaml $generalValues | nindent 8 }}
      -
{{- toYaml $storageLifecycleValues | nindent 8 }}
    needs:
      - cp-resources
      - cp-api-srv
    wait: true

  # ── cp-dav ────────────────────────────────────────────────────────────────────
  - name: cp-dav
    installed: {{ $davInstalled }}
    chart: ./cloud-pipeline/cp-dav
    values:
      - cloud-pipeline/cp-dav/values.yaml
      -
{{- toYaml $generalValues | nindent 8 }}
      -
{{- toYaml $davValues | nindent 8 }}
    needs:
      - cp-resources
      - cp-api-srv
    wait: true

  # ── cp-share-srv ──────────────────────────────────────────────────────────────
  - name: cp-share-srv
    installed: {{ $shareSrvInstalled }}
    chart: ./cloud-pipeline/cp-share-srv
    values:
      - cloud-pipeline/cp-share-srv/values.yaml
      -
{{- toYaml $generalValues | nindent 8 }}
      -
{{- toYaml $shareSrvValues | nindent 8 }}
    needs:
      - cp-resources
      - cp-idp
      - cp-api-srv
    wait: true

  # ── cp-run-policy-manager ─────────────────────────────────────────────────────
  - name: cp-run-policy-manager
    installed: {{ $runPolicyManagerInstalled }}
    chart: ./cloud-pipeline/cp-run-policy-manager
    values:
      - cloud-pipeline/cp-run-policy-manager/values.yaml
      -
{{- toYaml $generalValues | nindent 8 }}
      -
{{- toYaml $runPolicyManagerValues | nindent 8 }}
    needs:
      - cp-resources
      - cp-api-srv
    wait: true

  # ── cp-edge ───────────────────────────────────────────────────────────────────
  - name: cp-edge
    chart: ./cloud-pipeline/cp-edge
    values:
      - cloud-pipeline/cp-edge/values.yaml
      -
{{- toYaml $generalValues | nindent 8 }}
      -
{{- toYaml $edgeValues | nindent 8 }}
      -
{{- dict "git" $gitValues | toYaml | nindent 8 }}
    needs:
      - cp-resources
      - cp-idp
      - cp-api-srv
      - cp-docker-registry
      - cp-git
    wait: true

hooks:
  # ── pre-deploy: validate values.yaml ─────────────────────────────────────────
  - events: ["prepare"]
    showlogs: true
    command: bash
    args:
      - -c
      - |
        SCRIPT="./hooks/validation/validate-values.sh"
        VALUES_FILE="{{ $ValuesFilePath }}"
        [ -f "$SCRIPT" ] || { echo "ERROR: Script not found: $SCRIPT"; exit 1; }
        exec bash "$SCRIPT" "$VALUES_FILE"

{{- if index $postDeployValues "enabled" | default false }}
{{/* ── post-deploy cleanup hooks ──────────────────────────────────────────────── */}}

{{/* clusterNetworksConfig and SLS regions support both inline value and path-to-file */}}
{{- $clusterNetworkConfigValue := index $postDeployValues "clusterNetworksConfig" -}}
{{- $clusterNetworksB64 := "" -}}
{{- if kindIs "string" $clusterNetworkConfigValue -}}
  {{- $clusterNetworksB64 = readFile $clusterNetworkConfigValue | b64enc -}}
{{- else -}}
  {{- $clusterNetworksB64 = $clusterNetworkConfigValue | default dict | toJson | b64enc -}}
{{- end -}}

{{- $slsRegionsValue := index $storageLifecycleValues "regions" | default list -}}
{{- $slsRegionsB64 := "" -}}
{{- if kindIs "string" $slsRegionsValue -}}
  {{- $slsRegionsB64 = readFile $slsRegionsValue | b64enc -}}
{{- else -}}
  {{- $slsRegionsB64 = $slsRegionsValue | toJson | b64enc -}}
{{- end -}}

{{- $namespace := index $generalValues "namespace" | default "default" -}}

{{/* Each hook entry: script filename, enabled flag, env vars exported before the script runs */}}
{{- $hooks := list

  (dict "script"  "wait-for-api.sh"
        "enabled" true
        "env"     (dict))

  (dict "script"  "register-docker-tools.sh"
        "enabled" (index $postDeployValues "registerDockerTools" | default true)
        "env"     (dict
                    "CP_MANIFEST_DIR" "./hooks/post-deploy/assets/dockers-manifest"
                    "CP_TOOLS_JSON"   (index $postDeployValues "dockers" | default list | toJson)))

  (dict "script"  "apply-preferences.sh"
        "enabled" (index $postDeployValues "applyPreferences" | default true)
        "env"     (dict
                    "CP_SYSTEM_PREFERENCE_CONFIG" (env "CP_SYSTEM_PREFERENCE_CONFIG" | default (index $postDeployValues "systemPreferenceConfig" | default ""))))

  (dict "script"  "apply-cluster-networks-config.sh"
        "enabled" (index $postDeployValues "applyClusterNetworksConfig" | default true)
        "env"     (dict
                    "CP_POST_DEPLOY_CLUSTER_NETWORKS_SPEC_B64" $clusterNetworksB64))

  (dict "script"  "register-additional-cloud-regions.sh"
        "enabled" (index $postDeployValues "registerAdditionalCloudRegions" | default true)
        "env"     (dict
                    "CP_POST_DEPLOY_ADDITIONAL_CLOUD_REGIONS_B64" (index $postDeployValues "additionalCloudRegions" | default list | toJson | b64enc)))

  (dict "script"  "configure-storage-lifecycle-regions.sh"
        "enabled" $storageLifecycleInstalled
        "env"     (dict
                    "CP_POST_DEPLOY_SLS_REGIONS_B64"          $slsRegionsB64
                    "CP_POST_DEPLOY_SLS_REPORT_BUCKET_PREFIX" (index $storageLifecycleValues "reportBucketPrefix" | default "storage-lifecycle-service/tagging-job-reports")))

  (dict "script"  "register-demo-pipelines.sh"
        "enabled" $gitInstalled
        "env"     (dict))

  (dict "script"  "register-email-templates.sh"
        "enabled" (index $postDeployValues "registerEmailTemplates" | default true)
        "env"     (dict
                    "CP_POST_DEPLOY_EMAIL_NOTIFICATIONS_SPEC_B64" (index $postDeployValues "emailNotifications" | default dict | toJson | b64enc)))

  (dict "script"  "restart-cp-api-srv.sh"
        "enabled" (index $postDeployValues "restartApiSrv" | default true)
        "env"     (dict))
}}

{{- range $hooks }}
{{- if .enabled }}
  - events: ["cleanup"]
    showlogs: true
    command: bash
    args:
      - -c
      - |
        KUBE_NAMESPACE="{{ $namespace }}"
        {{- range $k, $v := .env }}
        export {{ $k }}='{{ $v }}'
        {{- end }}
        SCRIPT="./hooks/post-deploy/{{ .script }}"
        [ -f "$SCRIPT" ] || { echo "ERROR: Script not found: $SCRIPT"; exit 1; }
        exec bash "$SCRIPT" "$KUBE_NAMESPACE"
{{- end }}
{{- end }}
{{- end }}
