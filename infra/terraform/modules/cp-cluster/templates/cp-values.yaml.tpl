# Full Cloud Pipeline values.yaml, generated by the cp-cluster Terraform module.
# It installs the complete service set documented in ../../CLAUDE.md, pre-filled with this
# infrastructure's values. Use it in place of the stock helm/values.yaml, e.g.:
#   terraform output -raw cp_values_yaml > values.yaml
#   HELMFILE_VALUES=$(pwd)/values.yaml helmfile apply
#
# Anything not driven by Terraform (image tags, resource sizing, SMTP server, demo pipeline
# selection, etc.) keeps the defaults from each chart's own values.yaml -- edit this file
# directly to override them.

general:
  namespace: default
  imagePullCredentials:
    registry: ""
    user: ""
    password: ""
    secret: ""

resources:
  config:
    CP_CLOUD_PLATFORM: aws
    CP_CLOUD_REGION_ID: "${aws_region}"
    CP_DEFAULT_ADMIN_NAME: "${admin_name}"
    CP_DEFAULT_ADMIN_PASS: "${admin_password}"
    CP_DEFAULT_ADMIN_EMAIL: "${admin_email}"
    CP_KUBE_EXTERNAL_HOST: "${master_node_private_ip}"
    CP_DEPLOYMENT_ID: "${deployment_id}"
  customDNS:
    entries: []

idp:
  enabled: ${idp_enabled}
  service:
    host:
      external: "${idp_host}"

apiSrv:
  service:
    host:
      external: "${api_srv_host}"

  highAvailability:
    enabled: false

  db:
    type: internal
    db: pipeline
    user: pipeline
    pass: "${db_password}"

  cloudRegion:
    kmsKeyArn: "${kms_key_arn}"
    kmsKeyId: ""
    sshKeyName: "${ssh_key_name}"
    tempCredentialsRole: "${s3_via_sts_role_arn}"
    omicsServiceRole: ""
    omicsEcrUrl: ""
    fileShareMounts: []

  config:
    CP_PREF_UI_PIPELINE_DEPLOYMENT_NAME: "${deployment_id}"
    CP_API_SRV_SSO_ENDPOINT_ID: ""
    CP_PREF_STORAGE_SYSTEM_STORAGE_NAME: "${system_bucket_name}"

dockerRegistry:
  enabled: true
  service:
    host:
      external: "${docker_registry_host}"
  config:
    CP_DOCKER_STORAGE_CONTAINER: "${docker_registry_bucket_name}"
  clair:
    enabled: true

edge:
  region: "${aws_region}"
  externalIP: "${edge_external_ip}"
  service:
    host:
      external: "${edge_host}"

git:
  enabled: true
  patchDNS:
    enabled: true
  service:
    host:
      external: "${git_host}"
  config:
    CP_GITLAB_SSO_ENDPOINT_ID: ""
    CP_GITLAB_SSO_TARGET_URL: ""
    CP_GITLAB_SSO_TARGET_URL_TRAIL: ""
    GITLAB_ROOT_PASSWORD: "${gitlab_root_password}"

search:
  enabled: ${enable_search}
  elk:
    elasticsearch:
      enabled: true
  srv:
    mode: default

billing:
  enabled: ${enable_billing}

notifier:
  enabled: ${enable_notifier}
  smtp:
    enabled: false
    server:
      host: ""
      port: ""
    sslOnConnect: false
    startTls: true
    from: ""
    user: ""
    pass: ""
  ui:
    enabled: true
  azure:
    enabled: false
    tenantId: ""
    clientId: ""
    clientSecret: ""
    scopes: "https://graph.microsoft.com/.default"
    sender: ""
    dryRun: false

monitoring:
  enabled: ${enable_monitoring}
  heapster:
    enabled: true
  nodeLogger:
    enabled: true
  nodeReporter:
    enabled: true
  vmMonitor:
    enabled: true

storageLifecycle:
  enabled: ${enable_storage_lifecycle}
  reportBucketPrefix: "storage-lifecycle-service/tagging-job-reports"

dav:
  enabled: ${enable_dav}

shareSrv:
  enabled: ${share_srv_enabled}
  service:
    host:
      external: "${share_srv_host}"
    port:
      external: "443"
      internal: "31084"
  config: {}

runPolicyManager:
  enabled: ${enable_run_policy_manager}

postDeploy:
  enabled: ${enable_post_deploy}
  hooks:
    - name: WaitForApi
      enable: true

    - name: RegisterDockerTools
      enable: true
      data:
        CP_MANIFEST_DIR: "./hooks/post-deploy/assets/dockers-manifest"
        CP_TOOLS_JSON:
%{ for tool in docker_tools ~}
          - "${tool}"
%{ endfor ~}

    - name: ApplyPreferences
      enable: true
      data:
        CP_SYSTEM_PREFERENCE_CONFIG: ""

    - name: ApplyClusterNetworksConfig
      enable: true
      data:
        CP_POST_DEPLOY_CLUSTER_NETWORKS_SPEC:${cluster_networks_spec}

    - name: RegisterAdditionalCloudRegions
      enable: true
      data:
        CP_POST_DEPLOY_ADDITIONAL_CLOUD_REGIONS_SPEC: []

    - name: StorageLifecycleRegionsConfiguration
      enable: true
      data:
        CP_POST_DEPLOY_SLS_REPORT_BUCKET_PREFIX: "storage-lifecycle-service/tagging-job-reports"
        CP_POST_DEPLOY_SLS_REGIONS_SPEC: []

    - name: RegisterDemoPipelines
      enable: true

    - name: RegisterEmailTemplates
      enable: true
      data:
        CP_POST_DEPLOY_EMAIL_NOTIFICATIONS_SPEC:
          enableOnly: []

    - name: RestartApiServer
      enable: true
